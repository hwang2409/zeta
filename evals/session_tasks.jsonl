{"id":"zeta-session-publication","git_ref":"54323c1e87e76215fa4968d12779f538f8c32bde","prompt":"In this historical Zeta checkout, a failed session creation can leave a partial session directory, and session discovery then crashes on that missing metadata. Fix creation and discovery so a failed write does not publish a session, and sessions with missing or corrupt files do not prevent healthy ones from being listed. Preserve existing sessions, including unrelated pre-existing directories. Do not edit tests/test_session_publication_regression.py. Run its test and the existing session tests before finishing. When running Python tests inside this checkout, use PYTHONPATH=src:. so imports resolve to the checkout rather than the installed harness.","setup":{"tests/test_session_publication_regression.py":"from pathlib import Path\n\nimport pytest\n\nfrom zeta.core.session import SessionManager\n\n\ndef test_discovery_skips_a_session_without_metadata(tmp_path: Path) -> None:\n    manager = SessionManager(tmp_path)\n    good = manager.create(provider=\"fake\", model=\"offline\")\n    partial = manager.create(provider=\"fake\", model=\"offline\")\n    (partial.store.session_dir / \"meta.json\").unlink()\n\n    assert [item.session_id for item in manager.list_sessions()] == [good.metadata.session_id]\n    assert [item.session_id for item in manager.list_session_previews()] == [good.metadata.session_id]\n\n\n@pytest.mark.parametrize(\"damage\", [\"missing\", \"corrupt_header\", \"corrupt_tail\"])\ndef test_discovery_skips_unopenable_conversation(tmp_path: Path, damage: str) -> None:\n    manager = SessionManager(tmp_path)\n    good = manager.create(provider=\"fake\", model=\"offline\")\n    bad = manager.create(provider=\"fake\", model=\"offline\")\n    if damage == \"missing\":\n        bad.store.path.unlink()\n    elif damage == \"corrupt_header\":\n        bad.store.path.write_text(\"broken\\n\")\n    else:\n        with bad.store.path.open(\"a\") as handle:\n            handle.write(\"broken\\n\")\n\n    assert [item.session_id for item in manager.list_sessions()] == [good.metadata.session_id]\n    assert [item.session_id for item in manager.list_session_previews()] == [good.metadata.session_id]\n\n\ndef test_failed_creation_does_not_publish_a_partial_session(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    manager = SessionManager(tmp_path)\n\n    def interrupted_write(self: SessionManager, metadata: object) -> None:\n        assert list(manager.sessions_dir.iterdir()) == []\n        raise OSError(\"interrupted metadata write\")\n\n    monkeypatch.setattr(SessionManager, \"_write\", interrupted_write)\n    with pytest.raises(OSError, match=\"interrupted metadata write\"):\n        manager.create(provider=\"fake\", model=\"offline\")\n    assert list(manager.sessions_dir.iterdir()) == []\n\n\ndef test_racing_creation_preserves_foreign_directory(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    manager = SessionManager(tmp_path)\n    original_write = SessionManager._write\n    collisions: list[Path] = []\n\n    def racing_write(self: SessionManager, metadata: object) -> None:\n        original_write(self, metadata)\n        if not collisions:\n            path = manager.sessions_dir / metadata.session_id\n            path.mkdir()\n            (path / \"keep.txt\").write_text(\"foreign\")\n            collisions.append(path)\n\n    monkeypatch.setattr(SessionManager, \"_write\", racing_write)\n    opened = manager.create(provider=\"fake\", model=\"offline\")\n\n    assert len(collisions) == 1\n    assert (collisions[0] / \"keep.txt\").read_text() == \"foreign\"\n    assert opened.store.session_dir != collisions[0]\n    assert [item.session_id for item in manager.list_sessions()] == [opened.metadata.session_id]\n"},"checks":[{"path":"tests/test_session_publication_regression.py","unchanged":true},{"command":["python","-m","pytest","-q","tests/test_session_publication_regression.py","tests/test_s